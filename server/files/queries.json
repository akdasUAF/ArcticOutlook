{
    "UnwindPointsOfContact": {
        "Description": "This query unwinds the points of contact array into individual records within the collection that can then be modified / sorted / etc.",
        "Pipeline": [
            {
                "$unwind": {
                    "path": "$points_of_contact"
                }
            },
            {
                "$set": {
                    "Name": "$points_of_contact.NAME"
                }
            },
            {
                "$set": {
                    "Job_Title": "$points_of_contact.JOB TITLE"
                }
            },
            {
                "$set": {
                    "Type": "$points_of_contact.TYPE"
                }
            },
            {
                "$set": {
                    "Phone": "$points_of_contact.PHONE"
                }
            },
            {
                "$set": {
                    "Address": "$points_of_contact.ADDRESS"
                }
            },
            {
                "$set": {
                    "Email": "$points_of_contact.EMAIL.value"
                }
            },
            {
                "$unset": "points_of_contact"
            },
            {
                "$addFields": {
                    "Clean_Phone": {
                        "$reduce": {
                            "input": {
                                "$filter": {
                                    "input": {
                                        "$map": {
                                            "input": {
                                                "$range": [
                                                    0,
                                                    14,
                                                    1
                                                ]
                                            },
                                            "in": {
                                                "$substrCP": [
                                                    "$Phone",
                                                    "$$this",
                                                    1
                                                ]
                                            }
                                        }
                                    },
                                    "cond": {
                                        "$regexMatch": {
                                            "input": "$$this",
                                            "regex": "[0-9]"
                                        }
                                    }
                                }
                            },
                            "initialValue": "",
                            "in": {
                                "$concat": [
                                    "$$value",
                                    "$$this"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "$out": {
                    "db": "Arctic-Outlook-Raw",
                    "coll": "Contacts"
                }
            }
        ],
        "JSArray": [
